rules_version = '2';

// ============================================================
// SORO 공모전 - Storage 보안 규칙
//
// 학생 작품 파일(엽서 그림, 소리 앨범 음원)이 있는 곳입니다.
// 예전에는 구글 드라이브에 있었고, Firestore 에는 링크만 있었습니다.
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // 경로: submissions/<공모전ID>/<학생uid>/<항목>.<확장자>
    // uid 를 경로에 넣어 두어, 남의 자리에 올리는 것을 규칙으로 막습니다.
    match /submissions/{contestId}/{uid}/{fileName} {

      // 갤러리와 전자화랑은 로그인 없이도 보여야 해서 공개 읽기입니다.
      // (Firestore 의 submissions 도 같은 이유로 공개 읽기입니다)
      allow read: if true;

      // 본인 자리에만, 로그인한 상태로만 올릴 수 있습니다.
      // 크기 제한은 실수로 거대한 파일이 올라가는 것을 막는 용도입니다.
      // 엽서가 약 0.9MB, 음원이 그보다 크므로 20MB 로 둡니다.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('audio/.*')
                       || request.resource.contentType.matches('video/.*'));

      // 지우는 것은 본인과 선생님만.
      // 선생님 판별은 Firestore 의 users/{uid}.admin 을 그대로 씁니다.
      allow delete: if request.auth != null
                    && (request.auth.uid == uid
                        || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.admin == true);
    }

    // 그 외 경로는 전부 차단합니다.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
