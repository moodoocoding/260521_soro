rules_version = '2';

// ============================================================
// SORO 공모전 - Firestore 보안 규칙
//
// 지금 Apps Script 백엔드에서 손으로 짜 넣은 검증들을, 데이터베이스가
// 직접 강제하도록 옮긴 것입니다. 클라이언트 코드를 어떻게 조작하든
// 여기서 막히면 데이터는 바뀌지 않습니다.
//
// 특히 지금 구조로는 못 막던 것 하나가 여기서 해결됩니다:
//   "다른 학생을 사칭한 제출" — 예전에는 Users 시트에 그 조합이 있는지만
//   확인할 수 있어서, 갤러리에 노출된 남의 학년/반/이름을 그대로 베껴
//   보내면 통과했습니다. 이제는 로그인한 본인(request.auth.uid)이 아니면
//   애초에 문서를 쓸 수 없습니다.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 공통 판별 ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // 관리자는 하드코딩된 학번이 아니라 users/{uid} 문서의 admin 값으로 판별합니다.
    // (예전: 5학년 1반 27번 김태호인지 값 비교 → 위조 가능)
    //
    // 커스텀 클레임(request.auth.token.admin) 대신 문서를 읽는 이유:
    // 클레임을 붙이려면 서비스 계정 키가 필요한데, 학교 운영 환경에서 그 키를
    // 관리하는 부담이 큽니다. 문서 방식은 키 없이도 되고, 아래 users 규칙이
    // "학생은 자기 문서에 admin 을 붙일 수 없다"를 강제하므로 안전합니다.
    function isAdmin() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function settingValue(key) {
      return get(/databases/$(database)/documents/settings/$(key)).data.value;
    }

    function settingExists(key) {
      return exists(/databases/$(database)/documents/settings/$(key));
    }

    // 공모전이 접수를 받는 중인지.
    // 잠금이 명시적으로 false일 때만 열린 것으로 봅니다. 설정이 없으면 닫힘.
    function contestUnlocked(contestId) {
      return settingExists('contest_lock_' + contestId)
             && settingValue('contest_lock_' + contestId) == false;
    }

    // 젭퀴즈는 잠금이 아니라 "지금 진행 중인 회차"로 판단합니다.
    function isActiveZepRound(contestId) {
      return settingExists('zepquiz_active_round')
             && contestId == 'zepquiz_' + string(settingValue('zepquiz_active_round'));
    }

    function contestAcceptsEntries(contestId) {
      return contestId.matches('^zepquiz_.*')
             ? isActiveZepRound(contestId)
             : contestUnlocked(contestId);
    }

    // ---------- 학생 프로필 ----------
    // 비밀번호는 Firebase Auth가 관리하므로 여기엔 없습니다.

    match /users/{uid} {
      // 본인 프로필과 관리자만 읽을 수 있습니다.
      //
      // 처음에는 "로그인한 사용자 누구나"로 열어뒀는데, 그러면 학생도 전교생 명단과
      // 학급별 참여 통계를 그대로 읽을 수 있었습니다. 기존 백엔드는 이 조회에
      // 관리자 토큰을 요구했으므로 그 수준으로 되돌립니다.
      // 갤러리는 제출물에 복사해둔 이름을 쓰므로 이 제한의 영향을 받지 않습니다.
      allow read: if isOwner(uid) || isAdmin();

      // 가입: 자기 문서만, 그리고 uid가 본인이어야 합니다.
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasAll(['grade', 'classNum', 'number', 'name'])
                    && request.resource.data.grade is int
                    && request.resource.data.classNum is int
                    && request.resource.data.number is int
                    && request.resource.data.name is string;

      // 본인 프로필 수정은 가능하되, 관리자 표시는 스스로 붙일 수 없습니다.
      allow update: if (isOwner(uid) && !('admin' in request.resource.data)) || isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- 제출물 ----------
    // 문서 ID를 "<공모전ID>__<uid>"로 고정합니다. 그래서
    //   · 한 학생이 한 공모전에 하나만 낼 수 있는 게 DB 차원에서 보장되고
    //   · 다시 제출해도 같은 문서를 덮어써서 받은 반응이 사라지지 않습니다
    //     (예전에는 취소 후 재제출하면 id가 바뀌어 반응이 날아갔습니다)

    match /submissions/{submissionId} {
      // 갤러리·전자화랑이 로그인 없이도 보여야 해서 공개 읽기입니다.
      // ※ 학생 이름이 그대로 노출되는 건 지금 Apps Script 구조와 동일합니다.
      //    더 가리려면 공개용 사본 컬렉션을 따로 두어야 하며, 별도 결정 사항입니다.
      allow read: if true;

      allow create: if isOwner(request.resource.data.uid)
                    && submissionId == request.resource.data.contestId + '__' + request.auth.uid
                    && contestAcceptsEntries(request.resource.data.contestId)
                    // 심사용 항목은 학생이 스스로 붙일 수 없습니다.
                    && !request.resource.data.keys().hasAny(['isStarred', 'prizeStatus', 'award']);

      // 본인이 다시 제출(덮어쓰기)하는 경우 — 접수 중일 때만.
      // 소유자와 공모전은 바꿀 수 없습니다.
      allow update: if isAdmin()
                    || (isOwner(resource.data.uid)
                        && contestAcceptsEntries(resource.data.contestId)
                        && request.resource.data.uid == resource.data.uid
                        && request.resource.data.contestId == resource.data.contestId
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasAny(['isStarred', 'prizeStatus', 'award']));

      allow delete: if isAdmin() || isOwner(resource.data.uid);
    }

    // ---------- 감상 반응 ----------
    // 문서 ID를 "<제출물ID>__<uid>__<종류>"로 고정해서
    // 같은 사람이 같은 작품에 같은 반응을 두 번 남기는 걸 DB가 막습니다.

    match /reactions/{reactionId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && isOwner(request.resource.data.uid)
                    && reactionId == request.resource.data.submissionId
                                     + '__' + request.auth.uid
                                     + '__' + request.resource.data.type
                    && request.resource.data.type in ['read', 'art', 'heart'];
                    // [자기 작품 반응을 막지 않습니다]
                    // 처음에는 막도록 설계했지만, 실제 데이터에서 전체 반응의 16%(93건 중 15건)가
                    // 자기 작품에 남긴 것이었습니다. 초등학생이 방금 만든 자기 엽서에 하트를 누르는 건
                    // 자연스러운 행동이고, 막으면 그 기록이 그대로 사라집니다.
                    // 순위 정렬을 없앴기 때문에 "자기 점수 올리기" 문제도 크지 않습니다.
                    // 나중에 막기로 하면 규칙 한 줄로 되돌릴 수 있지만, 지금 버린 기록은 복구할 수 없습니다.

      // 반응은 수정하지 않고 누르거나(생성) 취소(삭제)만 합니다.
      allow update: if false;
      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ---------- 설정 ----------
    // 공모전 개폐, 활성 회차, 학급별 과자 지급 등

    match /settings/{key} {
      // 학생 화면이 공모전 상태를 알아야 하므로 공개 읽기입니다.
      allow read: if true;
      // 쓰기는 오직 관리자.
      allow write: if isAdmin();
    }

    // ---------- 계정 색인 ----------
    // uidOf(userKey) → 실제 계정 uid.
    //
    // 이전해 온 484명은 uid 를 직접 지정해 넣어서 둘이 같지만, 그 뒤로 가입하는
    // 학생은 Firebase 가 무작위 uid 를 발급하므로 다릅니다. 비밀번호를 잊은 학생은
    // 로그인을 못 해 자기 uid 를 알 수 없으니, 이 색인이 없으면 아래 초기화 요청을
    // 아예 만들 수 없습니다.
    //
    // 담고 있는 것은 uid 하나뿐이라 개인정보가 없습니다. 그래도 굳이 공개할
    // 이유가 없어 읽기는 선생님에게만 열어 둡니다(승인할 때 필요).
    match /accountIndex/{key} {
      allow read: if isAdmin();

      // 본인 uid 만 기록할 수 있고, uid 외의 값은 넣을 수 없습니다.
      allow create, update: if isSignedIn()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.keys().hasOnly(['uid']);

      allow delete: if isAdmin();
    }

    // ---------- 비밀번호 재설정 요청 ----------
    // 비밀번호를 잊은 학생은 로그인 자체를 못 하므로 이 요청만은 비로그인으로 만들 수 있어야 합니다.
    // 문서 ID 를 uid 로 고정해 한 학생당 대기 중인 요청이 하나만 존재하도록 했습니다.
    // 선생님이 처리하면 문서를 지웁니다(= 처리 완료).
    match /passwordResets/{uid} {
      // 실제로 존재하는 계정에 대해서만, pending 상태로만 만들 수 있습니다.
      // 실존 계정에 대해서만 만들 수 있습니다. 이전해 온 학생은 문서 id 가 곧
      // 실제 uid 라 users 에서 바로 확인되고, 이후 가입한 학생은 accountIndex 로
      // 확인합니다. 규칙 안의 exists() 는 읽기 권한과 무관하게 동작하므로
      // 로그인하지 못한 학생도 이 검사를 통과할 수 있습니다.
      allow create: if (exists(/databases/$(database)/documents/users/$(uid))
                        || exists(/databases/$(database)/documents/accountIndex/$(uid)))
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending';

      // 같은 학생이 다시 요청하는 것은 허용합니다 — 조건은 생성과 똑같습니다.
      //
      // 예전에는 수정을 전부 막았는데, 그러면 이미 요청해 둔 학생이 한 번 더 누를 때
      // 거부되고 화면에는 "가입된 계정이 없습니다" 가 떴습니다. 눌러도 반응이 없어
      // 다시 누른 아이에게 "네 정보가 틀렸다" 고 말하는 셈이라 오히려 헷갈립니다.
      // 조건이 생성과 같으므로 남의 요청을 엉뚱한 내용으로 바꿔 놓을 수는 없습니다.
      allow update: if (exists(/databases/$(database)/documents/users/$(uid))
                        || exists(/databases/$(database)/documents/accountIndex/$(uid)))
                    && request.resource.data.uid == uid
                    && request.resource.data.status == 'pending';
      allow read, delete: if isAdmin();
    }

    // ---------- 그 외 전부 차단 ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
